{
  // web/src/*.ts → web/ui/*.js as plain scripts (not modules), loaded in the order of SCRIPTS in plan-cli/src/web.rs
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "ui",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "pkg/plan_web.d.ts"]
}

{
  // web/src/*.ts → web/ui/*.js。モジュールにせず、index.html が読む順に並べた普通の script（plan-cli/src/web.rs の SCRIPTS）
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noEmitOnError": true,
    "rootDir": "src",
    "outDir": "ui",
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts", "pkg/plan_web.d.ts"]
}
